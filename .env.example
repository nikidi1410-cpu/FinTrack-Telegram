# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit file `.env`.

# ===== Aplikasi =====
APP_NAME=FinTrack-WA
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta

# ===== Keamanan =====
# ID pengguna Telegram yang diizinkan (angka, pisahkan dengan koma).
# Pesan dari pengguna lain akan diabaikan. Cek ID-mu dengan mengirim pesan ke @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# Wajib untuk mode webhook: string acak (huruf/angka/_/-) untuk memvalidasi request dari Telegram.
WEBHOOK_SECRET=

# ===== Telegram Bot =====
# Buat bot lewat @BotFather di Telegram, lalu salin token-nya ke sini.
TELEGRAM_BOT_TOKEN=
# polling = jalan di laptop tanpa URL publik | webhook = di server | off = bot mati
TELEGRAM_MODE=polling
# Hanya untuk mode webhook: URL publik server, mis. https://fintrack.example.com
PUBLIC_BASE_URL=

# ===== Gemini API =====
# Dapatkan API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Google Sheets =====
# Path ke file JSON Service Account (Google Cloud Console > IAM > Service Accounts > Keys).
# Bagikan spreadsheet ke email service account dengan akses Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# ID spreadsheet: bagian URL di antara /d/ dan /edit
GOOGLE_SHEETS_SPREADSHEET_ID=
SHEET_TRANSAKSI=Transaksi
SHEET_BUDGET=Budget_Kategori
SHEET_SUMMARY=Summary
# Catat bunga tabungan & pajak bunga? (true/false)
CATAT_BUNGA=false

# ===== Scheduler =====
SCHEDULER_ENABLED=true
